# Used when the whole backend folder is inside public_html.
# (Best: point a subdomain's document root at api/ so nothing else is reachable at all.)

# Pass the Authorization header through to PHP (many hosts drop it)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# Private files: never served
<FilesMatch "^(config\.php|config\.local\.php|config\.local\.php\.example|schema\.sql|README\.md|DEPLOY-CPANEL\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
